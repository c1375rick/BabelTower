' Babel Tower bridge auto-start (self-locating, ASCII-only).
' Generated by scripts\autostart.ps1 - do not write real paths into this file.
' Paths are resolved at runtime from this script's own location, so the
' folder can be extracted/moved/renamed anywhere (incl. non-ASCII paths).
Option Explicit
Dim fso, sh, root, node, server, https
Set fso = CreateObject("Scripting.FileSystemObject")
Set sh = CreateObject("WScript.Shell")
root = fso.GetParentFolderName(fso.GetParentFolderName(WScript.ScriptFullName))
node = root & "\portable-node\node.exe"
server = root & "\core\bridge_server.js"
https = root & "\core\bridge_https.js"
If Not fso.FileExists(node) Then node = "node"
If fso.FileExists(server) Then
  sh.Run """" & node & """ """ & server & """", 0, False
End If
' 2026-10-16: TLS terminator for the https panel channel. Booting only
' bridge_server leaves 8792 with no listener, the probe fails and the whole
' day falls back to BTIPC (seen live 08:47). Exits 3 by itself when the cert
' is missing (no harm); skipped when the file is absent (old package).
If fso.FileExists(https) Then
  sh.Run """" & node & """ """ & https & """", 0, False
End If
