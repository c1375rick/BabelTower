<?xml version="1.0" encoding="utf-8"?>
<!-- Contributor: Thirt927 (https://github.com/Thirt927/BabelTower), merged 2026-08-13 under GPL-3.0 -->
<!--
  Babel Tower: Deadlock 聊天布局覆盖
  本文件以原版 panorama/layout/chat.xml 的反编译重建结构为基础(Valve 素材,
  保留原结构以保证聊天功能与引擎数据绑定正常),额外加入 LinguaChat 的
  样式/脚本引用、设置按钮与设置面板。所有原版 ID / class / 属性保持不变。
  原版结构参考: references/poker_chat.xml(同源重建,Apache-2.0 仓库)
  注意:Panorama 的 Button 不渲染 text 属性,按钮文字必须用内嵌 <Label>。
-->
<root>
	<styles>
		<include src="s2r://panorama/styles/citadel_base_styles.vcss_c" />
		<include src="s2r://panorama/styles/chat.vcss_c" />
		<include src="s2r://panorama/styles/lingua_chat.vcss_c" />
	</styles>
	<scripts>
		<!-- 快捷语音模板兑底语料(自动生成,勿手改);必须先于 lingua_chat.vjs_c 加载 -->
		<include src="s2r://panorama/scripts/lingua_chat_quickchat_fallback.vjs_c" />
		<!-- 模板参数约束专名表(自动生成,勿手改) -->
		<include src="s2r://panorama/scripts/lingua_chat_gamenames_fallback.vjs_c" />
		<!-- 名称保护配对名单(自动生成,勿手改):全量 EN->ZH + 指纹,btipc07 握手用 -->
		<include src="s2r://panorama/scripts/lingua_chat_gamenames_pairs_fallback.vjs_c" />
		<!-- BTIPC 传输层(2026-10-28 从 lingua_chat.js 拆出):先于主脚本挂 LCTBTIPC,主文件别名解构 -->
		<include src="s2r://panorama/scripts/lingua_chat_btipc.vjs_c" />
		<!-- UI 文案/选项表数据(2026-10-28 任务①E 外置):数据文件,必须先于 lingua_chat.vjs_c —— 主文件顶部读全局别名 -->
		<include src="s2r://panorama/scripts/lingua_chat_i18n.vjs_c" />
		<include src="s2r://panorama/scripts/lingua_chat.vjs_c" />
		<!-- 设置面板 UI(2026-10-28 任务②C-1 拆分):必须晚于 lingua_chat.vjs_c —— 经 LCTNS 导入宿主符号,
		     并且必须在 lingua_chat_exp 探针之前(boot 延迟 0.1s,面板全局挂载先就绪) -->
		<!-- P4a 实验探针区(2026-10-12 分家):必须晚于 lingua_chat.vjs_c —— 核心先发布 LCTNS
		     装载顺序:fallback 三件 → lingua_chat_btipc → lingua_chat_i18n → lingua_chat(核心)→ panel → 探针 -->
		<include src="s2r://panorama/scripts/lingua_chat_exp.vjs_c" />
	</scripts>
	<snippets>
		<snippet name="ChatMessageSource">
			<Panel>
				<Label class="ChannelName" text="[{s:channel_name}]" />
				<Label class="SenderName" text="{s:sender_name}" />
			</Panel>
		</snippet>
		<snippet name="ChatMessageContents_Text">
			<Panel class="Text">
				<Label text="{s:message_text}" />
			</Panel>
		</snippet>
		<snippet name="ChatMessageContents_Ping">
			<Panel class="Ping">
				<!-- 2026-10-03 游戏更新(buildid 25689475)补的面板,本重建(源自
				     poker_chat 同源重建)没有 -> 任何 FindChildInLayoutFile("#TargetHeroImage")
				     查不到就 FATAL "Unable to find child 'TargetHeroImage' in layout
				     file panorama\layout\chat.xml" -> tier0!Plat_FatalError ->
				     RaiseException(0x80000003) -> 游戏进程崩溃(今日 9 次 dump)。
				     游戏 CSS 为证(chat.vcss_c):
				     .ChatMessage .MessageBody #MessageContents.Ping #TargetHeroImage
				       {width:20px;height:20px;margin-right:6px;visibility:collapse;}
				     ... #TargetHeroImage.IsHeroPing {visibility:visible;}
				     必须放 Ping snippet 内(注入进 MessageContents 的是这段内容,
				     放静态子节点会被注入抹掉),且置于 Label 前,与 flow-right 排布一致。 -->
				<Image id="TargetHeroImage" />
				<!-- html="true" = 富文本渲染开关,游戏当前 chat.vxml 的 PingLabel 带此属性
				     (实证:抠游戏编译产物 logs/game_chat.vxml_c,字符串序列
				     ... TargetHero / ping / html / true ...;而我们编译出的同段是
				     ... TargetHero / ping ... 没有 html。与
				     docs/panorama-api-census-6726.md 记录一致——html="true" 富文本 Label
				     仅 Ping 行 PingLabel 使用,消息正文是普通 Label,所以正文不加)。
				     漏掉它 -> ping_text 里的 <span class="highlight"> 标记不被渲染,
				     聊天行原样显示 HTML 源码(2026-10-04 实车截图:
				     <span class="highlight">Abrams</span>的大招好了)。 -->
				<Label id="PingLabel" text="{s:ping_text}" html="true" />
			</Panel>
		</snippet>
		<snippet name="ChatMessageSender_HeroImage">
			<Panel class="SenderHeroImage">
				<CitadelHeroImage id="HeroImage" heroimagestyle="small" />
			</Panel>
		</snippet>
		<snippet name="ChatMessageSender_AvatarImage">
			<Panel class="SenderAvatarImage">
				<CitadelAvatarImage id="AvatarImage" />
			</Panel>
		</snippet>
		<snippet name="ChatMessageSender_LocalClient">
			<Panel class="SenderLocalClient" />
		</snippet>
		<snippet name="ChatMessage">
			<Panel class="ChatMessage Expired">
				<Panel id="SenderImage" />
				<Panel class="MessageBody">
					<Panel id="MessageSource" />
					<Panel id="MessageContents" />
				</Panel>
			</Panel>
		</snippet>
	</snippets>
	<CitadelChat defaultfocus="ChatInput" hittest="false">
		<Panel id="ChatLinesArea" hittest="false">
			<Panel class="ChatLinesWrapper" hittest="false">
				<Panel id="ChatMessages" hittest="false" />
			</Panel>
		</Panel>
		<Label class="ChatDisabledLabel" text="#Citadel_Hud_ChatDisabled" hittest="false" />
		<Panel id="ChatControls">
			<Label id="ChatTargetLabel" text="#citadel_chat_placeholder" />
			<TextEntry id="ChatInput" oninputsubmit="LCTOnChatSubmit();" onblur="CitadelChatInputBlur();" placeholder="" maxchars="1024" />
			<Label id="LCTOutgoingFailTip" class="LCTOutgoingFailTip" text="" />
			<Panel id="LCTBridgeDot" class="LCTBridgeDot" />
			<Button id="LCTSettingsButton" class="LCTSettingsButton" onactivate="LCTOpenWebSettings();">
				<Label text="译" />
			</Button>
		</Panel>
		<!-- Babel Tower 桥接 HTML 面板通道(CitadelHTMLPanel;游戏内设置面板已移除,设置走网页 /tr) -->
		<CitadelHTMLPanel id="LCTBridgePanel" class="LCTBridgePanel" hittest="false" acceptsfocus="false" />
	</CitadelChat>
</root>
